# Copy to .env.local (or add as Secrets on Replit) to enable real publishing.

# Public base URL of this portal. Must match the OAuth redirect URIs registered below,
# and must be public https for Instagram (Meta downloads the video from this host).
# Redirect URIs to register:
#   <APP_URL>/api/oauth/youtube/callback
#   <APP_URL>/api/oauth/instagram/callback
APP_URL=

# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Enable "YouTube Data API v3" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta App Dashboard > Instagram > API setup with Instagram login > Business login settings.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
